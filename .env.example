# Environment variables for Town Therapy

# REQUIRED for admin ↔ volunteer sync across devices.
# Without these, each phone keeps its own local AsyncStorage copy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Civic Tips Assistant — live streaming chat with Dr. Rant
# Without a key, replies still type out locally (offline coach mode).
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Expo push (production)
# 1. Create an Expo account / EAS project and add projectId to app.json extra.eas.projectId
# 2. Set EXPO_ACCESS_TOKEN on the Supabase Edge Function `notify-new-event`
