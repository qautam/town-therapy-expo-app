{
  "expo": {
    "name": "Town Therapy",
    "slug": "town-therapy",
    "description": "Healing Hazaribagh — RANT. REPORT. REFORM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "towntherapy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#2D4F4F",
    "splash": {
      "backgroundColor": "#2D4F4F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#2D4F4F",
      "splash": {
        "backgroundColor": "#2D4F4F"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D4F4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "backgroundColor": "#2D4F4F",
      "splash": {
        "backgroundColor": "#2D4F4F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D4F4F"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Town Therapy uses your location to geotag civic reports so the town can respond."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Town Therapy lets you attach photos as evidence for civic reports.",
          "cameraPermission": "Town Therapy lets you take photos of issues you report."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2D4F4F",
          "sounds": []
        }
      ],
      "expo-mail-composer",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
