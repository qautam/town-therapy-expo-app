{
  "expo": {
    "name": "Town Therapy",
    "slug": "town-therapy",
    "description": "Healing Hazaribagh — RANT. REPORT. REFORM",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "towntherapy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#2D4F4F",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#2D4F4F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.towntherapy.app",
      "backgroundColor": "#2D4F4F",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#2D4F4F"
      }
    },
    "android": {
      "package": "club.towntherapy.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#2D4F4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "backgroundColor": "#2D4F4F",
      "softwareKeyboardLayoutMode": "resize",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#2D4F4F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#2D4F4F",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Town Therapy uses your location to geotag civic reports, alert nearby volunteers, and share live distance when someone is coming to help."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Town Therapy lets you attach photos as evidence for civic reports.",
          "cameraPermission": "Town Therapy lets you take photos of issues you report."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D4F4F",
          "sounds": []
        }
      ],
      "expo-mail-composer",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Town Therapy saves your volunteer ID card to your photo library.",
          "savePhotosPermission": "Town Therapy saves your volunteer ID card to your photo library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "487f76c9-6927-49c0-b524-9d6e8adc9ba3"
      }
    },
    "owner": "town-therapy"
  }
}
